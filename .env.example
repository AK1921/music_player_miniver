# ==============================================================================
# NEXORA ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Project URL (e.g. https://your-project-ref.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon Public Key (Found in Project Settings -> API)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# App Environment
EXPO_PUBLIC_APP_ENV=development

