{
  "expo": {
    "name": "AK",
    "slug": "nexora-media",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "nexora",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexora.mediaecosystem",
      "infoPlist": {
        "NSCameraUsageDescription": "NEXORA needs access to your camera to capture and upload photos and videos to your private media cloud.",
        "NSMicrophoneUsageDescription": "Allow AK to use your microphone for voice translation and recording video with sound.",
        "NSFaceIDUsageDescription": "NEXORA uses Face ID to securely unlock your zero-knowledge private vault.",
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.nexora.mediaecosystem",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0B0D17",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "NEXORA needs access to your camera to capture and securely store media.",
          "microphonePermission": "Allow AK to use your microphone for voice translation and recording video with sound."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow NEXORA to unlock your Private Vault with Face ID / Biometrics."
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-video",
        {
          "supportsPictureInPicture": true
        }
      ],
      "expo-asset",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow AK to use your microphone for voice translation and recording video with sound.",
          "speechRecognitionPermission": "Allow AK to transcribe speech for two-way translation."
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "14cd4f1d-3ec3-481a-bc02-9138e53b07e3"
      }
    }
  }
}
